  @override
  void visitIntegerLiteral(IntegerLiteral node) {
    if (!_categories.contains('constant')) return;
    final lexeme = node.literal.lexeme;
    if (lexeme != '0' && lexeme != '1') return;
    _add('constant', lexeme, lexeme == '0' ? '1' : '0', node.literal.offset,
        node.literal.length);
  }

