  @override
  void visitBooleanLiteral(BooleanLiteral node) {
    if (!_categories.contains('boolean')) return;
    final lexeme = node.literal.lexeme;
    _add('boolean', lexeme, lexeme == 'true' ? 'false' : 'true',
        node.literal.offset, node.literal.length);
