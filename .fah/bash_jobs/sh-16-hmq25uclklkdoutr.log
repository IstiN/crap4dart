== class ClassNamePart ==
  Token get typeName;
  TypeParameterList? get typeParameters;
  TypeParameterListImpl? get typeParameters;
  Token? get abstractKeyword;
  Token? get baseKeyword;
  ClassFragment? get declaredFragment;
  Token get equals;
  Token? get finalKeyword;
  ImplementsClause? get implementsClause;
  Token? get interfaceKeyword;
  Token? get mixinKeyword;
  Token? get sealedKeyword;
  NamedType get superclass;
  TypeParameterList? get typeParameters;
== class NamedType  ==
  Element? get element;
  ImportPrefixReference? get importPrefix;
  bool get isDeferred;
  Token get name;
  DartType? get type;
  TypeArgumentList? get typeArguments;
  Token get beginToken {
== class EnumDeclaration ==
  Token? get augmentKeyword;
  EnumBody get body;
  EnumFragment? get declaredFragment;
  Token get enumKeyword;
  ImplementsClause? get implementsClause;
  ClassNamePart get namePart;
  WithClause? get withClause;
  EnumBodyImpl get body => _body;
== class MixinDeclaration ==
  Token? get augmentKeyword;
  Token? get baseKeyword;
  ClassBody get body;
  MixinFragment? get declaredFragment;
  ImplementsClause? get implementsClause;
  Token get mixinKeyword;
  Token get name;
  MixinOnClause? get onClause;
  TypeParameterList? get typeParameters;
== class ExtensionTypeDeclaration ==
  Token? get augmentKeyword;
  ClassBody get body;
  ExtensionTypeFragment? get declaredFragment;
  Token get extensionKeyword;
  ImplementsClause? get implementsClause;
  ClassNamePart get namePart;
  PrimaryConstructorDeclaration get primaryConstructor;
  Token get typeKeyword;
== class ExtensionDeclaration ==
  Token? get augmentKeyword;
  ClassBody get body;
  ExtensionFragment? get declaredFragment;
  Token get extensionKeyword;
  Token? get name;
  ExtensionOnClause? get onClause;
  Token? get typeKeyword;
  TypeParameterList? get typeParameters;
== class MethodDeclaration ==
  Token? get augmentKeyword;
  FunctionBody get body;
  ExecutableFragment? get declaredFragment;
  Token? get externalKeyword;
  bool get isAbstract;
  bool get isComplete;
  bool get isGetter;
  bool get isOperator;
  bool get isSetter;
  bool get isStatic;
  Token? get modifierKeyword;
  Token get name;
  Token? get operatorKeyword;
  FormalParameterList? get parameters;
== class FunctionDeclaration ==
  Token? get augmentKeyword;
  ExecutableFragment? get declaredFragment;
  Token? get externalKeyword;
  FunctionExpression get functionExpression;
  bool get isComplete;
  bool get isGetter;
  bool get isSetter;
  Token get name;
  Token? get propertyKeyword;
  TypeAnnotation? get returnType;
