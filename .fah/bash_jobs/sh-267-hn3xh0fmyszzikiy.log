  void _add(
    String category,
    String original,
    String mutant,
    int offset,
    int length,
  ) {
    final line = _lineInfo.getLocation(offset).lineNumber as int;
    sites.add(MutationSite(
      file: _fileOf(node),
      line: line,
      method: _methodAt(offset),
      category: category,
      original: original,
      mutant: mutant,
      offset: offset,
      length: length,
    ));
  }

  String _fileOf(AstNode node) =>
      node.thisOrAncestorOfType<CompilationUnit>()?.lineInfo == null
          ? ''
          : _methods.isNotEmpty
              ? _methods.first.info.filePath
              : '';

  /// Containing extracted method's display name, or `null`.
  String? _methodAt(int offset) {
    for (final entry in _methods) {
      final node = entry.node;
      if (offset >= node.offset && offset <= node.end) {
        final info = entry.info;
        return '${info.className}.${info.methodName}';
      }
    }
    return null;
  }
